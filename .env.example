# Copia este archivo a .env y rellena tus claves. NUNCA subas .env al repo.

# LLM provider activo: "groq" (default) o "openai"
LLM_PROVIDER=groq

# Groq (llama-3.3-70b-versatile) — gratuito, default en desarrollo
GROQ_API_KEY=

# OpenAI (gpt-4o-mini) — opcional, activar cambiando LLM_PROVIDER=openai
OPENAI_API_KEY=

# Búsqueda web (necesaria para DOI/PubMed lookup)
TAVILY_API_KEY=

# Rutas del sistema
OBSIDIAN_VAULT_PATH=./obsidian
LATEX_OUTPUT_PATH=./latex/output